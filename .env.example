PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=https://localhost,https://brahmastravakkom.in,https://www.brahmastravakkom.in

# Fast2SMS API key (fast2sms.com -> Dev API). Leave blank to disable SMS
# notifications on member approval.
FAST2SMS_API_KEY=

# Gmail SMTP for email verification and password-reset OTPs.
# Use a Google App Password, not your regular Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Razorpay payment gateway (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
